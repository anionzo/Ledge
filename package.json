{
  "name": "ledge",
  "version": "0.1.4",
  "description": "Ledge — one frame, two screen edges. A clipboard shelf on the left, an AI agent quota gauge on the right.",
  "author": "Ledge",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anionzo/Ledge.git"
  },
  "homepage": "https://github.com/anionzo/Ledge",
  "bugs": {
    "url": "https://github.com/anionzo/Ledge/issues"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "npm run build && electron .",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:sqlite": "electron scripts/smoke-sqlite.cjs",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:win:store": "npm run build && electron-builder --win appx",
    "build:mac": "npm run build && electron-builder --mac dmg",
    "build:linux": "npm run build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "motion": "^12.23.12",
    "zustand": "^5.0.3"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "koffi": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.ledge.app",
    "productName": "Ledge",
    "publish": [
      {
        "provider": "github",
        "owner": "anionzo",
        "repo": "Ledge"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/node_modules/koffi/**/*",
      "**/node_modules/@resvg/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ledge"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "resources/icon.png",
      "maintainer": "Ledge"
    }
  }
}
